# Copy the Session pooler URI from Supabase Dashboard > Connect > ORM > Prisma.
# Use the exact URI Supabase provides and URL-encode reserved password characters.
# The Session pooler (port 5432) can be used for both Prisma URLs to start.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-unique-random-secret"
